# Copia este archivo a habit-tracker/.env.production (está en .gitignore)
# y rellena los valores del panel de InfinityFree. `php artisan deploy:build`
# lo copia como htdocs/laravel/.env.

APP_NAME="Hábitos"
APP_ENV=production
# Genera la clave en local: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
HABITS_TIMEZONE=America/Caracas
APP_URL=https://tu-subdominio.infinityfreeapp.com
APP_FORCE_HTTPS=true
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_DAILY_DAYS=7
LOG_LEVEL=warning

# Panel de InfinityFree > MySQL Databases
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_habitos
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=

# Archivos en vez de BD: menos consultas contra el límite del plan gratis.
SESSION_DRIVER=file
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

# El plan gratuito no envía correo.
MAIL_MAILER=log
